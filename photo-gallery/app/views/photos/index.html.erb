<div class="gallery-header">
  <h1>All Photos</h1>
</div>

<div class="photo-grid">
  <% @photos.each do |photo| %>
    <div class="photo-card" id="photo-<%= photo.id %>">
      <div class="photo-image-wrap">
        <%= image_tag photo.src_medium, alt: photo.title, class: "photo-img" %>
      </div>

      <div class="photo-meta">
        <p class="photo-photographer"><%= photo.photographer %></p>

        <div class="photo-actions">
          <a href="<%= photo.source_url %>" target="_blank" rel="noopener" class="photo-link">
            <%= image_tag "links.svg", class: "icon", alt: "Source" %>
          </a>

          <%= turbo_frame_tag "like-#{photo.id}" do %>
            <%= render "likes/button", photo: photo %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>