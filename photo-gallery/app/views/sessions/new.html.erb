<div class="login-container">
  <div class="login-box">
    <h1>Photo Gallery</h1>
    <p class="subtitle">Sign in to browse and like photos</p>

    <% if flash[:alert] %>
      <div class="alert alert-error">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with local: true, url: login_path, method: :post do |form| %>
      <div class="form-group">
        <%= form.label :username %>
        <%= form.text_field :username, placeholder: "Enter username", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :password %>
        <%= form.password_field :password, placeholder: "Enter password", class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Sign In", class: "btn btn-primary" %>
      </div>
    <% end %>

    <div class="demo-credentials">
      <p><strong>Demo Credentials:</strong></p>
      <p>Username: <code>demo</code></p>
      <p>Password: <code>password123</code></p>
    </div>
  </div>
</div>
