<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Photo Gallery</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="navbar">
      <%= image_tag "logo.svg", class: "navbar-logo", alt: "Clever" %>
      <% if current_user %>
        <div class="navbar-right">
          <span class="navbar-email"><%= current_user.email %></span>
          <%= button_to "Sign out", logout_path, method: :delete, class: "btn-signout" %>
        </div>
      <% end %>
    </header>
    <% if notice %>
      <p class="flash flash-notice"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="flash flash-alert"><%= alert %></p>
    <% end %>
    <main>
      <%= yield %>
    </main>
  </body>
</html>