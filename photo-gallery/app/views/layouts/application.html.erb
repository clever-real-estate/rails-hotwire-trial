<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Photo Gallery" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if current_user %>
      <header class="navbar">
        <div class="navbar-content">
          <div class="navbar-brand">
            <%= link_to photos_path, class: "brand-link" do %>
              <%= image_tag 'logo.svg', alt: 'Clever' %>
              <span>Photo Gallery</span>
            <% end %>
          </div>

          <div class="navbar-user">
            <span class="username">Welcome, <%= current_user.username %>!</span>
            <%= button_to logout_path, method: :delete, class: "btn btn-logout" do %>
              Logout
            <% end %>
          </div>
        </div>
      </header>
    <% end %>

    <% if flash[:notice] %>
      <div class="alert alert-success flash-notice">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
